[Unit]
Description=Eternal V4 Accurate SJ auto-sync every 5 minutes (+2m stagger)
Requires=eternal-v4-accurate-sj.service
# Jangan systemctl enable timer ini sebelum unified release Owner.

[Timer]
OnCalendar=*-*-* *:2/5:00
AccuracySec=15s
Persistent=false
Unit=eternal-v4-accurate-sj.service

[Install]
WantedBy=timers.target
