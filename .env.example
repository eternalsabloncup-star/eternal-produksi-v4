# Copy to .env for local development. Never commit real secrets.

APP_ENV=development
MONGODB_URI=mongodb://eternal:eternal_dev_password@mongo:27017/eternal_produksi_v4?authSource=admin&replicaSet=rs0&directConnection=false
MONGODB_DB=eternal_produksi_v4

# Cookie Secure flag: leave empty to derive from APP_ENV (true in production).
COOKIE_SECURE=

SESSION_TTL_SECONDS=86400
COOKIE_NAME=eternal_session
CSRF_COOKIE_NAME=eternal_csrf

# Comma-separated browser origins allowed by CORS (empty when using Vite proxy only).
CORS_ORIGINS=

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Fernet key (url-safe base64, 32 bytes) — seal raw token Live Tracking di Mongo.
# Production wajib sebelum cutover. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Jangan commit nilai production. Test/dev boleh kosong (derived non-prod).
# V4_TRACKING_LINK_SEAL_KEY=

# MongoDB Compose credentials (development only)
MONGO_ROOT_USERNAME=eternal
MONGO_ROOT_PASSWORD=eternal_dev_password
MONGO_INITDB_DATABASE=eternal_produksi_v4

# Backend listen (host machine when not using Compose network)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Vite
VITE_DEV_PORT=5173
# Inbox sumber data:
# - development (kosong): DEMO browser
# - production build: default api via frontend/.env.production
# - api|accurate: baca Mongo V4 (bukan Accurate live per request)
# - demo: paksa DEMO (termasuk saat uji lokal production preview)
VITE_INBOX_PO_SOURCE=

# Accurate Online (opsional — hanya sync/smoke manual; jangan isi secret di git)
# Utamakan prefix V4_* agar terpisah dari ERP lama.
# V4_ACCURATE_ACCOUNT_BASE=
# V4_ACCURATE_API_TOKEN=
# V4_ACCURATE_API_SIGNATURE_SECRET=
# V4_ACCURATE_DB_ID=
# V4_ACCURATE_REQUIRE_DB_PIN=1
#
# Kill switch sinkronisasi Surat Jalan Accurate → Mongo V4 (default OFF).
# Nyalakan hanya setelah verify_sj_sync_isolation.py PASS + persetujuan Owner.
# V4_SJ_SYNC_ENABLED=0
# Jalur production SJ terpisah (default OFF; butuh CEO + backup + non-prod PASS).
# V4_SJ_SYNC_PRODUCTION_ENABLED=0
#
# Auto-sync Accurate (worker one-shot terpisah dari FastAPI; default OFF).
# V4_PO_AUTO_SYNC_ENABLED=0
# V4_INVOICE_AUTO_SYNC_ENABLED=0
# V4_RECEIPT_AUTO_SYNC_ENABLED=0
# V4_ACCURATE_AUTO_SYNC_INTERVAL_SECONDS=60
#
# Loading Surat Jalan task (default OFF). Nyalakan HANYA lewat prosedur
# scripts/activate_loading_sj_release.py setelah PR #26 Accepted guard merged
# + Owner approval. Jangan set manual untuk melewati gate.
# V4_LOADING_SJ_TASK_ENABLED=0
# Contoh one-shot:
#   PYTHONPATH=backend python3 scripts/accurate_auto_sync_worker.py --job all
#
# Sync SJ hanya ke DB test terisolasi, contoh:
# DB_NAME=eternal_v4_test_sj_manual
